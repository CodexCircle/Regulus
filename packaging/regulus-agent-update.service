[Unit]
Description=Install a Regulus agent update (checks its signature, keeps the old version for a rollback)
Documentation=https://github.com/Stellatinus/Regulus
# Started by regulus-agent-update.path; not meant to be enabled.

[Service]
Type=oneshot
# Root: it replaces /usr/bin/regulus and restarts the agent. It trusts nothing in
# /var/lib/regulus-agent, which the agent's user can write: the release is
# verified again here (Sigstore signature of checksums.txt by the release
# workflow). The new agent is healthy when it connects to the hub again.
ExecStart=/usr/bin/regulus update-apply --agent --data-dir /var/lib/regulus-agent --state-dir /var/lib/regulus-update --unit regulus-agent.service
TimeoutStartSec=20min
# A stop (systemctl stop, a shutdown) must not cut the helper off in the middle
# of putting the old version back: the rollback has its own time.
TimeoutStopSec=5min
# Whatever ended the helper (killed, timed out, stopped), a leftover marker of
# an update in flight is settled now: the new version is checked or the old one
# is put back. "+" runs it with full privileges, outside the sandbox below; it
# does nothing when the update finished normally.
ExecStopPost=+/usr/bin/regulus update-apply --recover --state-dir /var/lib/regulus-update
StateDirectory=regulus-update
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/usr/bin -/var/lib/regulus-agent
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
